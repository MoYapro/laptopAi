# Copy to .env and adjust per machine.

# --- which compose files / services to use
# desktop (AMD):   compose.yaml:compose.amd.yaml
# laptop (NVIDIA): compose.yaml:compose.nvidia.yaml
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
COMPOSE_PROFILES=llm
OLLAMA_URL=http://llm:11434

# --- host ids (run: id -u; id -g; getent group video | cut -d: -f3)
UID=1000
GID=1000
VIDEO_GID=44
CAMERA_DEVICE=/dev/video0

# --- models (keep the LLM under ~3 GB so it fits the laptop's 4 GB VRAM)
LLM_MODEL=gemma3:4b
LLM_THINK=
WHISPER_MODEL=small
WHISPER_LANGUAGE=
PIPER_VOICE=en_US-lessac-medium
